# ─────────────────────────────────────────────────────────────────────────────
# DQ Pipeline – environment configuration template
#
# Copy this file to .env, fill in your values, and NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL connection ─────────────────────────────────────────────────────
DQ_DB_HOST=localhost
DQ_DB_PORT=5432
DQ_DB_NAME=mydb
DQ_DB_USER=postgres
DQ_DB_PASSWORD=changeme

# ── Schema and metadata tables ────────────────────────────────────────────────
# Schema that owns dq_control, dq_results and (by default) business tables.
DQ_DB_SCHEMA=public

# Name of the metadata table that stores validation rules.
DQ_CONTROL_TABLE=dq_control

# Name of the table where results are written.
DQ_RESULTS_TABLE=dq_results

# ── Pipeline behaviour ────────────────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR
DQ_LOG_LEVEL=INFO
$token = az account get-access-token --resource https://ossrdbms-aad.database.windows.net --query accessToken --output tsv
$content = Get-Content -Path .env
$updated = $content -replace '^DQ_DB_PASSWORD=.*', "DQ_DB_PASSWORD=$token"
Set-Content -Path .env -Value $updated